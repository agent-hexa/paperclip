{
  "name": "@agent-pixels/paperclip-plugin",
  "version": "0.1.0",
  "description": "Live security-camera pixel office for Paperclip companies — a Paperclip port of Pixel-Agents by Pablo De Lucca",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "homepage": "https://github.com/gcampton/Agent-Pixels",
  "repository": {
    "type": "git",
    "url": "https://github.com/gcampton/Agent-Pixels.git",
    "directory": "packages/plugins/agent-pixels"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "ui",
    "pixel",
    "agents"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps",
    "build": "tsc && node ./esbuild.config.mjs",
    "clean": "node ./scripts/clean.mjs",
    "typecheck": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps && tsc --noEmit"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}